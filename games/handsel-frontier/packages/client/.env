# Which chain the World lives on (31337 = local anvil started by `pnpm dev`).
VITE_CHAIN_ID=31337
# Which Handsel deployment the beacons' TEXT is read from (titles, briefs).
# The numbers on the map come from the chain, which the oracle mirrors from the
# same deployment — the HUD warns if the two disagree. Defaults to the V2
# rehearsal (Base Sepolia, faucet USDC, no monetary value). Point it at
# https://handsel-main.vercel.app only if the oracle is mirroring mainnet too.
VITE_HANDSEL_URL=https://handsel-nu.vercel.app
